# Environment Configuration
ENVIRONMENT=development
DEBUG=true
APP_NAME="FreshCart Grocery Platform"
API_V1_STR="/api/v1"
SECRET_KEY="freshcart-super-secret-production-grade-key-change-in-prod-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration
DATABASE_URL="sqlite+aiosqlite:///./freshcart.db"
# Production PostgreSQL URL:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/freshcart_db"

# Redis Cache & Locks
REDIS_URL="redis://localhost:6379/0"

# RabbitMQ / Celery
CELERY_BROKER_URL="amqp://guest:guest@localhost:5672//"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:8000"]

# Delivery & Geolocation
DEFAULT_DELIVERY_RADIUS_KM=15.0
EXPRESS_DELIVERY_WINDOW_MINUTES=30
SLOT_CAPACITY_PER_WINDOW=25

# Payment Gateway Mock / Production
PAYMENT_GATEWAY_MODE="mock"
STRIPE_API_KEY="sk_test_mock_stripe_key"
RAZORPAY_KEY_ID="rzp_test_mock_key"
RAZORPAY_KEY_SECRET="mock_razorpay_secret"

# Notification Services
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="notifications@freshcart.com"
SMTP_PASSWORD="mock_smtp_password"
EMAILS_FROM_EMAIL="support@freshcart.com"
EMAILS_FROM_NAME="FreshCart Grocery"
TWILIO_ACCOUNT_SID="mock_twilio_sid"
TWILIO_AUTH_TOKEN="mock_twilio_token"
TWILIO_PHONE_NUMBER="+1234567890"

# OpenSearch / Elasticsearch
SEARCH_ENGINE_URL="http://localhost:9200"
SEARCH_INDEX_PREFIX="freshcart"
